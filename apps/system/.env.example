VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Modo de pruebas local: true = la app habla con el Postgres/PostgREST de docker/compose.yml (pnpm db:up)
# en vez de Supabase. No hay login: la sesión es la de VITE_LOCAL_USER (ver docker/README.md).
VITE_USE_LOCAL_DB=false
VITE_POSTGREST_URL=http://localhost:54330
VITE_LOCAL_USER=admin@felinas.test
VITE_LOCAL_JWT_SECRET=felinas-local-dev-secret-not-for-production
