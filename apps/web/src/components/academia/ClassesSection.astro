---
import { Image } from "astro:assets";
// Fotos de las tarjetas (9:16). Las de los instructores (avatares) son las mismas de "Conoce a tus profes".
import cardTwerkRecreativo from "../../assets/academia/clase-card-twerk-recreativo.webp";
import cardUrbano from "../../assets/academia/clase-card-urbano.webp";
import cardBreaking from "../../assets/academia/clase-card-breaking.webp";
import cardFlex from "../../assets/academia/clase-card-flex.webp";
import cardTwerkAvanzado from "../../assets/academia/clase-card-twerk-avanzado.webp";
import maeProfe from "../../assets/academia/clase-twerk-avanzado.webp";
import angelicaProfe from "../../assets/academia/clase-hip-hop.webp";
import evelsProfe from "../../assets/academia/clase-breaking.webp";
import andreaProfe from "../../assets/academia/profe-andrea.webp";

const WHATSAPP_NUMBER = "573203426558";
const classBookingUrl = (title: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`¡Hola! Quiero agendar la clase de ${title} en Felinas`)}`;

type ClassInfo = {
  title: string;
  styles?: string[];
  description: string;
  /** Etiqueta de nivel: indica para quién es la clase, no su intensidad. */
  level: string;
  trailerUrl?: string;
  portada: ImageMetadata;
  /**
   * "cover" llena la tarjeta 9:16. "contain" muestra la foto entera sobre una copia desenfocada
   * de sí misma: así las fotos cuadradas, de pose abierta, no pierden brazos ni piernas al recortarse.
   */
  fit: "cover" | "contain";
  /** object-position para fit "cover". */
  pos?: string;
  /** Dos tonos de la familia rosa-morado de marca: cada clase tiene el suyo y todas se ven hermanas. */
  tone: { from: string; to: string };
  teacher: { name: string; role: string; social: string; photo: ImageMetadata };
};

const classes: ClassInfo[] = [
  {
    title: "Twerk Recreativo",
    description: "Una clase grupal para todos los niveles, pensada para venir a disfrutar, soltar el cuerpo y divertirte sin una formación estructurada.",
    level: "Todos los niveles",
    trailerUrl: "https://www.youtube.com/embed/p-4LGl15AIk",
    portada: cardTwerkRecreativo,
    // Foto horizontal: a "cover" en una tarjeta 9:16 se ampliaba ~2.7x y se pixelaba; entera se ve nítida.
    fit: "contain",
    tone: { from: "#ff006a", to: "#b5179e" },
    teacher: { name: "Mae", role: "Instructora de Twerk Recreativo", social: "https://www.instagram.com/mae.aleja", photo: maeProfe },
  },
  {
    title: "Urbano",
    styles: ["Popping", "House", "Hip Hop"],
    description: "En estas clases descubre tu identidad, desarrolla tu estilo y prueba nuevas formas de expresarte a través de una de las danzas urbanas más influyentes del mundo.",
    level: "Sin experiencia",
    trailerUrl: "https://www.youtube.com/embed/HiPuniltcn4",
    portada: cardUrbano,
    fit: "contain",
    tone: { from: "#e0127f", to: "#7b2cbf" },
    teacher: { name: "Angélica", role: "Instructora de Urbano", social: "https://www.instagram.com/angee.ortizg", photo: angelicaProfe },
  },
  {
    title: "Breaking",
    description: "En estas clases desafía tus límites, fortalece tu cuerpo y explora el movimiento desde la creatividad, la disciplina y la cultura urbana.",
    level: "Sin experiencia",
    trailerUrl: "https://www.youtube.com/embed/HpC0wH0wZog",
    portada: cardBreaking,
    fit: "cover",
    pos: "55% 50%",
    tone: { from: "#c2188f", to: "#4a1d96" },
    teacher: { name: "Jahn Evels", role: "Instructor de Breaking", social: "https://www.instagram.com/bboyevelss", photo: evelsProfe },
  },
  {
    title: "Flex, Yoga y Gimnasia",
    description: "En estas clases desarrolla fuerza, flexibilidad, movilidad y conciencia corporal a través de prácticas que complementan tu formación en danza, mejorando el control del movimiento, el equilibrio y el bienestar físico.",
    level: "Sin experiencia",
    trailerUrl: "https://www.youtube.com/embed/8PsQwdEasdM",
    portada: cardFlex,
    fit: "contain",
    tone: { from: "#d946ef", to: "#7c3aed" },
    teacher: { name: "Andrea Altamirano", role: "Instructora de Flex, Yoga y Gimnasia", social: "https://www.instagram.com/andrealtamirano_", photo: andreaProfe },
  },
  {
    title: "Twerk Avanzado",
    description: "En estas clases encontrarás enfoque en técnica, exploración, musicalidad, acrobacias, control corporal y freestyle. Ideal para llevar tu experiencia a otro nivel.",
    level: "Con experiencia",
    trailerUrl: "https://www.youtube.com/embed/PWJwZYkTZmw",
    portada: cardTwerkAvanzado,
    fit: "cover",
    pos: "50% 35%",
    tone: { from: "#ff006a", to: "#6d1b9e" },
    teacher: { name: "Mae", role: "Instructora de Twerk Avanzado", social: "https://www.instagram.com/mae.aleja", photo: maeProfe },
  },
];

const toneStyle = (t: ClassInfo["tone"]) => `--g1:${t.from};--g2:${t.to}`;
---

<!--
  Escenario anclado: la sección se fija y las clases pasan UNA A LA VEZ (entra una, sale la otra) al
  scrollear (initClassStage). En móvil o con reduced-motion no se ancla: quedan en fila, una tras otra.
  Cada clase es un zig-zag con una tarjeta vertical 9:16 que VOLTEA:
  el frente es la foto y el reverso es el trailer. Un toque voltea (igual en desktop y celular, sin
  depender del hover); "Volver", Esc o abrir otra tarjeta la regresan. El iframe solo se carga al
  voltear y se vacía al volver, para no cargar 5 reproductores de YouTube de entrada ni dejar audio
  sonando. La tarjeta es 9:16 porque los trailers lo son: al voltear, el video llena el reverso.
-->
<section id="clases" class="py-20 md:py-24 bg-gradient-to-b from-white via-[#fdf2f7] to-white relative overflow-hidden">
  <div class="absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-primary/[0.07] blur-[130px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
  <div class="absolute bottom-1/4 left-0 w-[420px] h-[420px] rounded-full bg-[#9b1fd1]/[0.05] blur-[110px] -translate-x-1/4 pointer-events-none"></div>
  <span class="logo-mark absolute top-16 -right-16 h-[380px] w-[420px] pointer-events-none hidden md:block" aria-hidden="true"></span>

  <div class="container px-4 relative z-10">
    <div class="mb-12 md:mb-16">
      <h2 class="text-foreground">
        <span class="title-eyebrow">Nuestros estilos</span>
        <span class="title-main">NUESTRAS <span class="title-accent">CLASES</span></span>
      </h2>
      <p class="mt-4 max-w-xl text-muted-foreground text-base md:text-lg font-light leading-relaxed">
        Cinco formas de moverte. Toca cualquier tarjeta para ver el trailer de la clase.
      </p>
      <a href="#twerk-personalizado" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-foreground/70 hover:text-primary transition-colors">
        <span class="w-2 h-2 rounded-full bg-primary" aria-hidden="true"></span>
        También tenemos clases personalizadas de Twerk desde cero
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <div data-stage class="stage relative flex flex-col gap-16">
      {classes.map((c, i) => {
        const isEven = i % 2 !== 0;
        return (
          <div data-stage-slide class="stage-slide" style={toneStyle(c.tone)}>
          <div class="grid md:grid-cols-12 items-center gap-6 md:gap-8 lg:gap-12 w-full">
            <!-- Tarjeta que voltea -->
            <div data-stage-card data-dir={isEven ? "1" : "-1"} class:list={["md:col-span-5 relative z-20 flex justify-center", isEven ? "md:order-2 md:justify-start" : "md:justify-end"]}>
              <!-- Luz de la clase: círculo de degradado detrás de la tarjeta; el escenario lo hace florecer al entrar -->
              <div data-stage-wash class="absolute inset-0 -z-10 flex items-center justify-center pointer-events-none" aria-hidden="true">
                <div class="class-aura h-[125%] aspect-square rounded-full blur-3xl opacity-[0.17]"></div>
              </div>
              <!-- Ancho derivado del alto (66vh, tope 620px, deja sitio al menú) para que la tarjeta 9:16 siempre quepa en pantalla -->
              <div data-flip data-trailer={c.trailerUrl ?? ""} class="flip relative aspect-[9/16] w-[82%] max-w-[340px] md:w-[calc(min(66vh,620px)*0.5625)] md:max-w-none">
                <!-- Luz de color detrás: degradado simple de la clase, sin exagerar -->
                <div class="class-aura absolute -inset-3 -z-10 rounded-[2rem] blur-2xl opacity-25 pointer-events-none"></div>

                <div class="flip-inner">
                  <!-- Frente -->
                  <button type="button" data-flip-open={i} data-class-card aria-label={`Ver trailer de ${c.title}`} class="flip-face flip-front group text-left cursor-pointer bg-[#f3eef2] shadow-2xl shadow-black/20 ring-1 ring-black/5">
                    {c.fit === "cover" ? (
                      <Image
                        src={c.portada}
                        alt={c.title}
                        widths={[480, 720, 1000]}
                          quality={74}
                        sizes="(max-width: 768px) 82vw, 400px"
                        loading="lazy"
                        style={`object-position:${c.pos ?? "50% 50%"}`}
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"
                      />
                    ) : (
                      <>
                        <Image src={c.portada} alt="" aria-hidden="true" width={320} loading="lazy" class="absolute inset-0 h-full w-full object-cover scale-125 blur-2xl opacity-80" />
                        <Image
                          src={c.portada}
                          alt={c.title}
                          widths={[480, 720, 1000]}
                          quality={74}
                          sizes="(max-width: 768px) 82vw, 400px"
                          loading="lazy"
                          class="class-contain absolute inset-x-0 inset-y-0 my-auto h-auto w-full transition-transform duration-[1200ms] ease-out group-hover:scale-[1.05]"
                        />
                      </>
                    )}
                    <div class="class-fade absolute inset-0 pointer-events-none"></div>
                    <div class="class-glow absolute inset-0 pointer-events-none"></div>
                    <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 p-5 sm:p-6 text-white">
                      <span class="font-display font-black uppercase leading-[0.95] text-2xl sm:text-3xl drop-shadow">{c.title}</span>
                      {/* Play: botón sólido (nunca se anima su opacidad) con un aro que late detrás, y la
                          etiqueta "Trailer" para que se entienda que se toca. */}
                      <span class="flex shrink-0 flex-col items-center gap-1.5">
                        <span class="relative grid h-16 w-16 place-items-center">
                          <span data-ambient="pulse" class="absolute inset-0 rounded-full bg-white/50"></span>
                          <span class="relative grid h-16 w-16 place-items-center rounded-full bg-white text-primary shadow-[0_8px_24px_rgb(0_0_0/0.45)] ring-4 ring-white/40 transition-transform duration-300 group-hover:scale-110">
                            <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7 translate-x-0.5" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                          </span>
                        </span>
                        <span class="text-[10px] font-bold uppercase tracking-[0.22em] drop-shadow">Trailer</span>
                      </span>
                    </span>
                  </button>

                  <!-- Reverso: el trailer es 9:16 igual que la tarjeta, así que ocupa casi todo el reverso -->
                  <div class="flip-face flip-back class-back flex flex-col text-white" inert>
                    <div class="relative min-h-0 flex-1 bg-black">
                      <iframe
                        data-flip-iframe
                        class="absolute inset-0 h-full w-full"
                        src=""
                        title={`Trailer ${c.title}`}
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture"
                        allowfullscreen
                      ></iframe>
                    </div>
                    <div class="flex shrink-0 items-center gap-2 p-3">
                      <button type="button" data-flip-close class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-white/20 px-4 py-3 text-[11px] font-bold uppercase tracking-widest backdrop-blur transition-colors hover:bg-white hover:text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                        Volver
                      </button>
                      <a href={classBookingUrl(c.title)} target="_blank" rel="noopener noreferrer" class="flex-1 rounded-full bg-white py-3 text-center font-display text-xs font-bold uppercase tracking-widest text-primary transition-transform hover:scale-[1.02]">Reserva tu cupo</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Texto -->
            <div data-stage-text class:list={["md:col-span-7 flex flex-col", isEven ? "md:order-1 md:items-end md:text-right" : "md:items-start"]}>
              <div class:list={["flex flex-wrap items-center gap-2 mb-4", isEven && "md:justify-end"]}>
                <span class="rounded-full border border-primary/25 bg-white/70 px-3.5 py-1 text-[11px] font-bold uppercase tracking-widest text-foreground/70">Grupal</span>
                <span class="class-level inline-flex items-center gap-2 rounded-full px-3.5 py-1 text-[11px] font-bold uppercase tracking-widest text-white">
                  <span class="h-1.5 w-1.5 rounded-full bg-white"></span>{c.level}
                </span>
              </div>

              <h3 class="font-display font-black text-4xl md:text-5xl lg:text-6xl text-foreground uppercase leading-[0.95] mb-4">{c.title}</h3>
              {c.styles && (
                <ul class:list={["flex flex-wrap gap-2 mb-4", isEven && "md:justify-end"]}>
                  {c.styles.map((s) => <li class="rounded-full bg-primary/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{s}</li>)}
                </ul>
              )}
              <p class="text-muted-foreground text-base md:text-lg leading-relaxed max-w-lg">{c.description}</p>

              <a href={c.teacher.social} target="_blank" rel="noopener noreferrer" class:list={["mt-5 flex items-center gap-3 group", isEven && "md:flex-row-reverse"]}>
                <Image src={c.teacher.photo} alt={c.teacher.name} width={112} loading="lazy" class="h-12 w-12 shrink-0 rounded-full object-cover object-top ring-2 ring-primary/30 group-hover:ring-primary transition" />
                <span class:list={["leading-tight", isEven && "md:text-right"]}>
                  <span class="block font-display font-bold text-sm text-foreground group-hover:text-primary transition-colors">{c.teacher.name}</span>
                  <span class="block text-[11px] uppercase tracking-widest text-muted-foreground">{c.teacher.role}</span>
                </span>
              </a>

              <!-- Una sola acción principal por clase; el trailer vive en la tarjeta -->
              <div class:list={["mt-6 flex flex-wrap items-center gap-4", isEven && "md:justify-end"]}>
                <a
                  href={classBookingUrl(c.title)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-felina"
                >
                  Reserva tu cupo
                  <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                </a>
                {c.trailerUrl && (
                  <button type="button" data-flip-open={i} data-flip-scroll class="text-sm font-semibold text-foreground/70 hover:text-primary transition-colors underline underline-offset-4 decoration-primary/40">
                    Ver trailer
                  </button>
                )}
              </div>
            </div>
          </div>
          </div>
        );
      })}

      <!-- Riel de progreso: solo en modo anclado. Puntos sin numeración; el nombre aparece al pasar el mouse. -->
      <ol class="stage-rail" aria-label="Clases">
        {classes.map((c, i) => (
          <li>
            <button type="button" data-stage-dot={i} aria-label={`Ir a ${c.title}`} class="stage-dot group">
              <span class="stage-dot-label">{c.title}</span>
              <span class="stage-dot-mark"></span>
            </button>
          </li>
        ))}
      </ol>
    </div>

    <!-- Twerk personalizado: bloque propio (no es una clase grupal más, pero tiene que verse). Tono neutro a propósito: queda justo antes de Instructores, que ya trae el título con degradado, y dos así juntos cansan. El color de marca se concentra en pocos puntos: franja superior, eyebrow, "1:1", checks y botón; el título va en tinta. -->
    <div id="twerk-personalizado" data-reveal class="mt-20 md:mt-28 scroll-mt-24">
      <div class="relative overflow-hidden rounded-[2rem] md:rounded-[3rem] border border-border bg-gradient-to-br from-white via-white to-[#fdf3f7] shadow-sm p-6 sm:p-10 md:p-14">
        <!-- Franja de marca arriba: la misma de las tarjetas de planes. Es el único color grande del bloque. -->
        <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-primary to-[#9b1fd1]"></div>
        <div class="absolute -top-24 -left-20 w-[380px] h-[380px] rounded-full bg-primary/[0.04] blur-[100px] pointer-events-none"></div>

        <div class="relative z-10 grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
          <!-- Mensaje: etiqueta → título → texto → acción -->
          <div class="lg:col-span-7 min-w-0" style="container-type: inline-size;">
            <p class="inline-block border border-primary/30 text-primary text-xs font-bold tracking-widest uppercase px-4 py-1 rounded-full mb-6 bg-background/60">Clases 1 a 1 · Desde cero</p>
            <h3 class="text-foreground">
              <span class="title-eyebrow text-primary">Twerk</span>
              <span class="title-main" style="font-size: clamp(1.4rem, 9cqw, 6rem);">PERSONALIZADO</span>
            </h3>
            <p class="mt-6 text-muted-foreground text-lg md:text-xl leading-relaxed font-light max-w-xl">
              ¿Prefieres aprender a tu ritmo? Una clase hecha a tu medida: sin grupo, sin presión y con un plan que se adapta a tu cuerpo, tus objetivos y tu horario.
            </p>
            <a
              href="#membresias"
              data-open-plan-tab="personalizado"
              class="btn-felina mt-8"
            >
              Quiero mi clase personalizada
              <svg class="btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
            </a>
          </div>

          <!-- Ancla visual + beneficios -->
          <div class="lg:col-span-5">
            <div class="rounded-3xl bg-white border border-border shadow-lg shadow-black/5 p-6 md:p-8">
              <div class="flex items-end gap-4 pb-6 mb-6 border-b border-border">
                <span class="title-accent font-display font-black leading-[0.8] tracking-tighter" style="font-size: clamp(4rem, 9vw, 6.5rem);">1:1</span>
                <span class="pb-1 text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground leading-snug">Tú y tu<br />instructora</span>
              </div>
              <ul class="flex flex-col gap-4">
                {["Empiezas desde cero, sin experiencia", "Atención 100% enfocada en ti", "Horario y ritmo a tu medida"].map((item) => (
                  <li class="flex items-center gap-4 text-foreground font-medium">
                    <span class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Familia de color por clase: --g1/--g2 vienen del style de cada fila. */
  .class-level,
  .class-aura { background: linear-gradient(135deg, var(--g1), var(--g2)); }
  .class-back { background: linear-gradient(160deg, var(--g1), var(--g2)); }
  /* Degradado inferior: solo lo justo para leer el título, sin teñir toda la foto. */
  .class-fade {
    background: linear-gradient(to top, color-mix(in srgb, var(--g2) 82%, transparent) 0%, color-mix(in srgb, var(--g1) 28%, transparent) 34%, transparent 58%);
  }

  /* La foto entera (su propia caja, no la de la tarjeta) se difumina arriba y abajo para fundirse con su copia borrosa, sin cortes duros. */
  .class-contain {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }

  /* Modo anclado: lo activa JS (data-pinned) solo en escritorio y con movimiento permitido. Sin eso,
     las clases son una lista normal, así que nada depende de que el script cargue. */
  .stage-rail { display: none; }
  .stage[data-pinned="true"] { height: 100vh; min-height: 640px; gap: 0; }
  .stage[data-pinned="true"] .stage-slide {
    position: absolute; inset: 0; display: flex; align-items: center; padding-top: 4.5rem;
    visibility: hidden; opacity: 0;
  }
  .stage[data-pinned="true"] .stage-slide:first-of-type { visibility: visible; opacity: 1; }
  .stage[data-pinned="true"] .stage-rail {
    position: absolute; left: 0; top: 50%; z-index: 30; display: flex; flex-direction: column; gap: 0.35rem; transform: translateY(-50%);
  }
  .stage-dot { display: flex; flex-direction: row-reverse; align-items: center; justify-content: flex-end; gap: 0.75rem; padding: 0.4rem 0; cursor: pointer; }
  .stage-dot-mark { height: 0.5rem; width: 0.5rem; border-radius: 999px; background: rgb(0 0 0 / 0.18); transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .stage-dot[aria-current="true"] .stage-dot-mark { height: 1.75rem; background: linear-gradient(180deg, #ff006a, #9b1fd1); }
  .stage-dot-label {
    font-family: 'Montserrat', sans-serif; font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: #0a0a0a; opacity: 0; transform: translateX(-6px); transition: all 0.3s; pointer-events: none; white-space: nowrap;
  }
  .stage-dot:hover .stage-dot-label,
  .stage-dot:focus-visible .stage-dot-label { opacity: 1; transform: none; }

  /* Logo de marca teñido (el SVG es claro): mismo recurso que la tarjeta de comunidad. */
  .logo-mark {
    background: linear-gradient(135deg, #ff006a, #9b1fd1);
    -webkit-mask: url(/assets/PanteraFelinasLogo.svg) center / contain no-repeat;
    mask: url(/assets/PanteraFelinasLogo.svg) center / contain no-repeat;
    opacity: 0.05;
  }

  /* Flip 3D */
  /* Sin transition ni :hover sobre transform: el escenario anima este elemento con GSAP (scrub) y una
     transición CSS encima interpola entre cuadros, lo que se veía como un movimiento extraño. */
  .flip { perspective: 1600px; }
  .flip-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1); }
  .flip[data-flipped="true"] .flip-inner { transform: rotateY(180deg); }
  .flip-face { position: absolute; inset: 0; overflow: hidden; border-radius: 1.5rem; backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .flip-back { transform: rotateY(180deg); }

  /* Brillo que sigue al cursor: solo cambia el fondo de una capa, no dispara layout */
  .class-glow {
    opacity: 0;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgb(255 255 255 / 0.28), transparent 60%);
    mix-blend-mode: soft-light;
    transition: opacity 0.4s;
  }
  .flip-front:hover .class-glow { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .flip,
    .flip-inner { transition-duration: 0.01s; }
  }
</style>

<script>
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)");
  const flips = Array.from(document.querySelectorAll<HTMLElement>("[data-flip]"));

  // Brillo con el cursor (solo con puntero fino)
  flips.forEach((flip) => {
    const front = flip.querySelector<HTMLElement>("[data-class-card]");
    front?.addEventListener("pointermove", (e) => {
      if (!fine.matches) return;
      const r = front.getBoundingClientRect();
      front.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
      front.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });

  const setFlipped = (flip: HTMLElement, on: boolean, restoreFocus = true) => {
    if (flip.dataset.flipped === String(on)) return;
    const front = flip.querySelector<HTMLElement>(".flip-front")!;
    const back = flip.querySelector<HTMLElement>(".flip-back")!;
    const iframe = flip.querySelector<HTMLIFrameElement>("[data-flip-iframe]")!;
    flip.dataset.flipped = String(on);
    // La cara oculta no debe recibir foco ni clics (backface-visibility no lo evita en todos los navegadores).
    front.inert = on;
    back.inert = !on;

    if (on) {
      const url = flip.dataset.trailer;
      // El src se asigna recién al voltear; vaciarlo al volver detiene el audio.
      if (url) iframe.src = `${url}?autoplay=1&rel=0&playsinline=1`;
      back.querySelector<HTMLElement>("[data-flip-close]")?.focus({ preventScroll: true });
    } else {
      iframe.src = "";
      if (restoreFocus) front.focus({ preventScroll: true });
    }
  };

  document.querySelectorAll<HTMLElement>("[data-flip-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = flips[Number(btn.dataset.flipOpen)];
      if (!target) return;
      // Una a la vez: abrir un trailer cierra el que estuviera sonando.
      flips.forEach((f) => f !== target && setFlipped(f, false, false));
      setFlipped(target, true);
      // El enlace "Ver trailer" del texto puede dejar la tarjeta fuera de pantalla: se centra.
      if (btn.hasAttribute("data-flip-scroll")) target.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });
  document.querySelectorAll<HTMLElement>("[data-flip-close]").forEach((btn) => {
    btn.addEventListener("click", () => setFlipped(btn.closest<HTMLElement>("[data-flip]")!, false));
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") flips.forEach((f) => setFlipped(f, false));
  });
  // El escenario anclado avisa cuando cambia la clase visible: el trailer de la anterior se detiene.
  document.addEventListener("class-stage-change", (e) => {
    const active = (e as CustomEvent<{ index: number }>).detail.index;
    flips.forEach((f, i) => i !== active && setFlipped(f, false, false));
  });
</script>
