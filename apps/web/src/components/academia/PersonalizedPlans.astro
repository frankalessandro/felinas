---
import { planWhatsappURL } from "../../scripts/whatsapp";

/** 12345 → "12.345". Manual para no depender del ICU del entorno de build. */
const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ".");

const plans = [
  { name: "Plan Shake", classes: 4, solo: 200000, duo: 300000 },
  { name: "Plan Jiggle", classes: 8, solo: 360000, duo: 560000 },
].map((p) => ({
  ...p,
  perPerson: p.duo / 2,
  // Lo que se ahorra una pareja frente a contratar dos planes individuales.
  saving: p.solo * 2 - p.duo,
  hrefSolo: planWhatsappURL(p.name + " (Personalizado 1 persona)", "$" + fmt(p.solo)),
  hrefDuo: planWhatsappURL(p.name + " (Personalizado dúo)", "$" + fmt(p.duo)),
}));

const includes = [
  { title: "Mini videos recap", text: "de las clases", icon: "video" },
  { title: "Flexibilidad", text: "de horarios", icon: "clock" },
  { title: "Seguimiento", text: "personalizado", icon: "follow" },
] as const;
---

<div data-personalized data-mode="solo">
  <div class="mb-12 flex justify-center">
    <div role="radiogroup" aria-label="Para cuántas personas" class="relative grid w-full max-w-md grid-cols-2 rounded-full border border-border bg-background p-1.5 shadow-sm">
      <span data-thumb class="absolute inset-y-1.5 left-1.5 w-[calc(50%-0.375rem)] rounded-full bg-primary shadow-md shadow-primary/30" aria-hidden="true"></span>

      <button type="button" role="radio" aria-checked="true" data-set-mode="solo" class="relative z-10 flex items-center justify-center gap-3 rounded-full py-3 text-white transition-colors">
        <span class="h-3.5 w-3.5 rounded-full bg-current" aria-hidden="true"></span>
        <span class="text-left leading-tight">
          <span class="block font-display text-sm font-black uppercase tracking-wide">Felina</span>
          <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] opacity-70">1 persona</span>
        </span>
      </button>

      <button type="button" role="radio" aria-checked="false" data-set-mode="duo" class="relative z-10 flex items-center justify-center gap-3 rounded-full py-3 text-foreground/60 transition-colors">
        <span class="relative block h-3.5 w-6" aria-hidden="true">
          <span class="absolute left-0 h-3.5 w-3.5 rounded-full bg-current opacity-90"></span>
          <span class="absolute left-2.5 h-3.5 w-3.5 rounded-full bg-current opacity-55"></span>
        </span>
        <span class="text-left leading-tight">
          <span class="block font-display text-sm font-black uppercase tracking-wide">Dúo Felinas</span>
          <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] opacity-70">Parejas</span>
        </span>
      </button>
    </div>
  </div>

  <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
    {plans.map((p) => (
      <div
        data-reveal
        data-pcard
        data-solo={p.solo}
        data-duo={p.duo}
        data-href-solo={p.hrefSolo}
        data-href-duo={p.hrefDuo}
        class="relative flex flex-col overflow-hidden rounded-3xl bg-felina-negro p-7 text-white xl:p-9"
      >
        <div class="pointer-events-none absolute -right-16 -top-24 h-64 w-64 rounded-full bg-primary/35 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-24 -left-16 h-56 w-56 rounded-full bg-felina-morado/50 blur-3xl"></div>

        <div class="relative flex items-center justify-between">
          <h3 class="rounded-full bg-white/10 px-4 py-1.5 font-display text-xs font-bold uppercase tracking-[0.22em] text-white ring-1 ring-white/15">{p.name}</h3>
          <span class="relative block h-8 w-14" aria-hidden="true">
            <span class="absolute left-0 h-8 w-8 rounded-full bg-primary"></span>
            <span data-dot2 class="absolute left-5 h-8 w-8 rounded-full bg-white/80" style="transform: scale(0); opacity: 0;"></span>
          </span>
        </div>

        <div class="relative mt-8" style="container-type: inline-size;">
          <p class="flex items-start gap-1.5">
            <span class="mt-2 font-display text-xl font-bold text-white/55">$</span>
            <span data-price class="font-display font-black leading-none tracking-tighter" style="font-size: clamp(2.8rem, 17cqw, 4.6rem);">{fmt(p.solo)}</span>
          </p>
          <div class="mt-3 min-h-[3.25rem]">
            <p class="only-solo text-xs font-semibold uppercase tracking-[0.18em] text-white/55">al mes · 1 persona</p>
            <div class="only-duo">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/55">al mes · 2 personas</p>
              <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-white/85">
                <span><strong class="font-display font-black">${fmt(p.perPerson)}</strong> por persona</span>
                <span class="rounded-full bg-primary/25 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-white ring-1 ring-primary/40">Ahorran ${fmt(p.saving)}</span>
              </p>
            </div>
          </div>
        </div>

        <div class="relative mt-6 flex items-center gap-4 rounded-2xl bg-white/[0.07] px-5 py-4 ring-1 ring-white/10">
          <span class="font-display font-black leading-none tracking-tighter" style="font-size: 2.6rem;">{p.classes}</span>
          <span class="text-xs font-bold uppercase leading-snug tracking-[0.18em] text-white/60">clases<br />al mes</span>
        </div>

        <a
          data-cta
          href={p.hrefSolo}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative mt-8 flex w-full items-center justify-center gap-2 rounded-full bg-primary py-3.5 font-display text-xs font-bold uppercase tracking-widest text-white shadow-lg shadow-primary/30 transition-colors hover:bg-felina-rosa-glow"
        >
          Elegir este plan
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
      </div>
    ))}
  </div>

  <div data-reveal class="mx-auto mt-10 max-w-4xl">
    <p class="mb-4 text-center font-display text-[11px] font-bold uppercase tracking-[0.25em] text-foreground/50">Incluido en todos los personalizados</p>
    <div class="grid gap-4 sm:grid-cols-3">
      {includes.map((item) => (
        <div class="flex items-center gap-4 rounded-2xl border border-border bg-card px-5 py-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {item.icon === "video" && (<><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m10 9.5 5 2.5-5 2.5z" /></>)}
              {item.icon === "clock" && (<><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>)}
              {item.icon === "follow" && (<><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4.5" /><circle cx="12" cy="12" r="0.8" fill="currentColor" /></>)}
            </svg>
          </span>
          <p class="leading-tight">
            <span class="block font-display text-sm font-bold uppercase tracking-wide text-foreground">{item.title}</span>
            <span class="block text-xs text-foreground/55">{item.text}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  [data-mode="solo"] .only-duo,
  [data-mode="duo"] .only-solo {
    display: none;
  }
</style>

<script>
  import { gsap, reduceMotion } from "../../scripts/gsap";

  type Mode = "solo" | "duo";

  const root = document.querySelector<HTMLElement>("[data-personalized]");
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-set-mode]"));
    const thumb = root.querySelector<HTMLElement>("[data-thumb]")!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-pcard]"));
    const fmt = (n: number) => String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    const counters = new Map<HTMLElement, { v: number }>();
    let mode: Mode = "solo";

    const setMode = (next: Mode) => {
      if (next === mode) return;
      mode = next;
      root.dataset.mode = next;
      const duo = next === "duo";
      const dur = reduceMotion() ? 0 : 0.5;

      buttons.forEach((b) => {
        const on = b.dataset.setMode === next;
        b.setAttribute("aria-checked", String(on));
        b.classList.toggle("text-white", on);
        b.classList.toggle("text-foreground/60", !on);
      });
      gsap.to(thumb, { xPercent: duo ? 100 : 0, duration: dur, ease: "power3.out" });

      cards.forEach((card) => {
        const priceEl = card.querySelector<HTMLElement>("[data-price]")!;
        const state = counters.get(card) ?? { v: Number(card.dataset.solo) };
        counters.set(card, state);
        gsap.killTweensOf(state);
        gsap.to(state, {
          v: Number(duo ? card.dataset.duo : card.dataset.solo),
          duration: dur,
          ease: "power3.out",
          onUpdate: () => { priceEl.textContent = fmt(state.v); },
        });

        gsap.to(card.querySelector("[data-dot2]"), { scale: duo ? 1 : 0, opacity: duo ? 1 : 0, duration: dur, ease: "back.out(1.8)" });
        gsap.fromTo(card.querySelectorAll(duo ? ".only-duo" : ".only-solo"), { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: dur ? 0.35 : 0, delay: dur ? 0.08 : 0 });

        const cta = card.querySelector<HTMLAnchorElement>("[data-cta]")!;
        cta.href = (duo ? card.dataset.hrefDuo : card.dataset.hrefSolo) ?? cta.href;
      });
    };

    buttons.forEach((b) => b.addEventListener("click", () => setMode(b.dataset.setMode as Mode)));
  }
</script>
